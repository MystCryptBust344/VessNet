# ==============================================================================
# VessGen-Net v2 — .gitignore
# ==============================================================================

# Raw dataset archives (too large for git)
Dataset/
*.tar
*.zip

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Generated / large binary outputs
results/preprocessing_check/*.png
results/preprocessing_check/*.jpg

# Auto-generated large binary outputs — exclude
# configs/normalization_stats.json  # keep tracked — small JSON file

# Actual image data in data/ (large — re-run organize_datasets.py to populate)
data/DRIVE/train/images/*.tif
data/DRIVE/train/masks/*.gif
data/DRIVE/train/masks/*.png
data/DRIVE/train/fov_masks/*.gif
data/DRIVE/train/fov_masks/*.png
data/DRIVE/test/images/*.tif
data/DRIVE/test/masks/*.gif
data/DRIVE/test/masks/*.png
data/DRIVE/test/fov_masks/*.gif
data/DRIVE/test/fov_masks/*.png
data/CHASE/target_train/images/*.jpg
data/CHASE/target_train/images/*.png
data/CHASE/target_train/masks/*.png
data/CHASE/target_test/images/*.jpg
data/CHASE/target_test/images/*.png
data/CHASE/target_test/masks/*.png
data/STARE/external_test/images/*.ppm
data/STARE/external_test/images/*.png
data/STARE/external_test/masks/*.ppm
data/STARE/external_test/masks/*.png

# Manifest CSV (regenerated by organize_datasets.py — check in for reference)
# data/manifest.csv  # ← keep this tracked

# Jupyter checkpoints
.ipynb_checkpoints/

# OS artifacts
Thumbs.db
.DS_Store
